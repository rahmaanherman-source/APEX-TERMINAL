@dataclass
class Evidence:
    claim: str
    state: str
    source: str
    action: str = ""
    expected: str = ""
    actual: str = ""
    timestamp: str = field(default_factory=lambda: datetime.now(timezone.utc).isoformat())
    commit_or_deployment_id: str = ""
    verified_by: str = ""
    notes: str = ""

    def __post_init__(self) -> None:
        if self.state not in TRUTH_STATES:
            raise ValueError(f"Invalid truth state: {self.state}")


class EvidenceLedger:
    """Append-only in-process evidence ledger; persistence is explicit."""

    def __init__(self) -> None:
        self.records: List[Evidence] = []
        self._lock = threading.Lock()

    def record(self, evidence: Evidence) -> Dict[str, Any]:
        with self._lock:
            self.records.append(evidence)
        return asdict(evidence)

    def export(self, path: str) -> str:
        target = Path(path)
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(
            json.dumps([asdict(item) for item in self.records], indent=2),
            encoding="utf-8",
        )
        return str(target)


# ---------------------------------------------------------------------------
# Network / integrity guard
# ---------------------------------------------------------------------------
class NetworkSentinel:
    def __init__(self, root: str = ".") -> None:
        self.root = Path(root).resolve()
        self.online = False
        self._checksum_before: Optional[str] = None
        self._lock = threading.Lock()

    def _system_checksum(self) -> str:
        digest = hashlib.sha256()
        for path in sorted(self.root.rglob("*.py")):
            if ".git" in path.parts or "__pycache__" in path.parts:
                continue
            try:
                digest.update(path.relative_to(self.root).as_posix().encode())
                digest.update(path.read_bytes())
            except OSError as exc:
                log.warning("Checksum skipped %s: %s", path, exc)
        return digest.hexdigest()

    def go_online(self) -> bool:
        with self._lock:
            self._checksum_before = self._system_checksum()
            self.online = True
        return True

    def go_offline(self) -> Dict[str, Any]:
        with self._lock:
            after = self._system_checksum()
            clean = self._checksum_before == after
            self.online = False
        return {
            "status": "CLEAN" if clean else "MODIFIED — REVIEW REQUIRED",
            "clean": clean,
            "checksum_before": self._checksum_before,
            "checksum_after": after,
            "timestamp": datetime.now(timezone.utc).isoformat(),
        }

    def online_task(self, task_fn: Callable[..., Any], *args: Any, **kwargs: Any) -> Any:
        self.go_online()
        try:
            return task_fn(*args, **kwargs)
        finally:
            result = self.go_offline()
            if not result["clean"]:
                log.critical("Online task modified tracked Python files")

    @property
    def status(self) -> str:
        return "ONLINE" if self.online else "OFFLINE"


# ---------------------------------------------------------------------------
# Git adapter — reports evidence; does not invent deployment state
# ---------------------------------------------------------------------------
class GitHubPipeline:
    def __init__(self, sentinel: NetworkSentinel, repo_path: str = ".") -> None:
        self.sentinel = sentinel
        self.repo_path = Path(repo_path).resolve()

    def _run(self, command: List[str]) -> Dict[str, Any]:
        try:
            result = subprocess.run(
                command,
                cwd=self.repo_path,
                capture_output=True,
                text=True,
                timeout=120,
                check=False,
            )
            return {
                "success": result.returncode == 0,
                "code": result.returncode,
                "stdout": result.stdout.strip(),
                "stderr": result.stderr.strip(),
            }
        except (OSError, subprocess.TimeoutExpired) as exc:
            return {"success": False, "code": -1, "stdout": "", "stderr": str(exc)}

    def status(self) -> Dict[str, Any]:
        result = self._run(["git", "status", "--porcelain=v1"])
        changes = result["stdout"].splitlines() if result["stdout"] else []
        return {**result, "changes": changes, "clean": result["success"] and not changes}

    def branch(self) -> Dict[str, Any]:
        return self._run(["git", "branch", "--show-current"])

    def commit_id(self) -> Dict[str, Any]:
        return self._run(["git", "rev-parse", "HEAD"])

    def stage_all(self) -> Dict[str, Any]:
        return self._run(["git", "add", "-A"])

    def commit(self, message: str) -> Dict[str, Any]:
        if not message.strip():
            raise ValueError("Commit message cannot be empty")
        return self._run(["git", "commit", "-m", message.strip()])

    def push(self, branch: str = "main") -> Dict[str, Any]:
        return self.sentinel.online_task(
            self._run, ["git", "push", "origin", branch]
        )

    def full_deploy(self, message: str, branch: str = "main") -> Dict[str, Any]:
        """Perform the local git release sequence and return actual evidence.

        This is intentionally called a git release, not an application deployment.
        A provider deployment must be verified separately.
        """
        staged = self.stage_all()
        committed = self.commit(message) if staged["success"] else {"success": False}
        pushed = self.push(branch) if committed["success"] else {"success": False}
        return {
            "staged": staged,
            "committed": committed,
            "pushed": pushed,
            "branch": branch,
            "timestamp": datetime.now(timezone.utc).isoformat(),
        }


# ---------------------------------------------------------------------------
# Provider registry / credential references
# ---------------------------------------------------------------------------
@dataclass
class Provider:
    name: str
    capabilities: List[str]
    credential_ref: Optional[str] = None
    endpoint: Optional[str] = None
    status: str = "UNVERIFIED"


class ServiceRegistry:
    def __init__(self) -> None:
        self.providers: Dict[str, Provider] = {}

    def register(self, provider: Provider) -> Dict[str, Any]:
        self.providers[provider.name] = provider
        return asdict(provider)

    def get(self, name: str) -> Optional[Provider]:
        return self.providers.get(name)

    def snapshot(self) -> Dict[str, Any]:
        return {name: asdict(provider) for name, provider in self.providers.items()}


# ---------------------------------------------------------------------------
# Shopify lane — safe contract, no secret handling
# ---------------------------------------------------------------------------
class ShopifyLane:
    """Shopify execution boundary.

    The lane accepts a credential reference, never a raw token. Real Shopify
    calls belong behind a configured provider adapter and must write evidence.
    """

    def __init__(self, registry: ServiceRegistry, ledger: EvidenceLedger) -> None:
        self.registry = registry
        self.ledger = ledger

    def configure(self, shop_alias: str, endpoint: str, credential_ref: str) -> Dict[str, Any]:
        if not credential_ref or credential_ref.lower().startswith(("shpat_", "sk_", "token_")):
            raise ValueError("ShopifyLane requires a credential reference, not a secret")
        provider = Provider(
            name=f"shopify:{shop_alias}",
            capabilities=["products.read", "products.write", "bulk.operations"],
            credential_ref=credential_ref,
            endpoint=endpoint,
            status="CONFIGURED_NOT_VERIFIED",
        )
        return self.registry.register(provider)

    def record_operation(
        self,
        shop_alias: str,
        operation: str,
        expected: str,
        actual: str,
        success: bool,
        operation_id: str = "",
    ) -> Dict[str, Any]:
        state = "VERIFIED" if success else "UNVERIFIED"
        return self.ledger.record(
            Evidence(
                claim=f"Shopify {operation} for {shop_alias}",
                state=state,
                source=f"shopify:{shop_alias}",
                action=operation,
                expected=expected,
                actual=actual,
                commit_or_deployment_id=operation_id,
            )
        )


# ---------------------------------------------------------------------------
# Canonical response contract
# ---------------------------------------------------------------------------
class ApexEngineTerminal:
    VERSION = VERSION
    OWNER = OWNER
    ENTITY = ENTITY
    PATENT = PATENT

    def __init__(self, project_root: str = ".") -> None:
        self.project_root = Path(project_root).resolve()
        self.sentinel = NetworkSentinel(project_root)
        self.git = GitHubPipeline(self.sentinel, project_root)
        self.ledger = EvidenceLedger()
        self.services = ServiceRegistry()
        self.shopify = ShopifyLane(self.services, self.ledger)
        self.session_log: List[Dict[str, Any]] = []

    def status_report(self) -> Dict[str, Any]:
        return {
            "engine": f"APEX ENGINE TERMINAL v{self.VERSION}",
            "owner": self.OWNER,
            "entity": self.ENTITY,
            "patent": self.PATENT,
            "truth_rule": "No fake green. Evidence before success.",
            "network": self.sentinel.status,
            "git": self.git.status(),
            "services": self.services.snapshot(),
            "evidence_count": len(self.ledger.records),
            "project": str(self.project_root),
            "timestamp": datetime.now(timezone.utc).isoformat(),
        }

    def command(self, request: str, phase: str = "ORIGIN") -> Dict[str, Any]:
        if phase not in LIFECYCLE:
            raise ValueError(f"Invalid lifecycle phase: {phase}")
        response = {
            "phase": {"current": phase, "next": LIFECYCLE[(LIFECYCLE.index(phase) + 1) % len(LIFECYCLE)]},
            "best_answer": {
                "summary": "Execute the smallest evidence-producing action for the request.",
                "confidence_percent": 90,
                "basis": "Canonical APEX lifecycle and verification rules.",
            },
            "alternatives": [
                {"path": "FAST_TEST", "pros": ["fast evidence", "low blast radius"], "cons": ["limited scope"]},
                {"path": "FULL_BUILD", "pros": ["broader validation"], "cons": ["higher cost and risk"]},
            ],
            "checklist": [
                "Classify the request.",
                "Inspect existing assets before creating duplicates.",
                "Execute the smallest real test.",
                "Record actual output in the evidence ledger.",
                "Advance the truth/build state only when evidence supports it.",
            ],
            "roadmap": [
                "ORIGIN → CLEAN → IMPROVE → FREEZE",
                "DEPLOY → HEALTH CHECK → INTEGRATION TEST → EVIDENCE RECORD",
                "MONETIZE → LOOP",
            ],
            "decision_tree": {
                "evidence_present": "advance state",
                "evidence_missing": "remain explicitly unverified",
                "provider_error": "record error, retry only under policy, then dead-letter if exhausted",
            },
            "request": request,
        }
        self.session_log.append(response)
        return response


def main() -> None:
    engine = ApexEngineTerminal(os.getcwd())
    print(json.dumps(engine.status_report(), indent=2))


if __name__ == "__main__":
    main()
