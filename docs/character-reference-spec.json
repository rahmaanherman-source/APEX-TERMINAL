{
  "name": "apex-character-reference-spec",
  "version": "1.0.0",
  "status": "DOCUMENTED",
  "method_doc": "docs/APEX_CHARACTER_REFERENCE_METHOD.md",
  "rule": "Never generate a character from a single photo. Feed the full reference set.",
  "grid": {
    "type": "rule_of_thirds_3x3",
    "background": "plain dark",
    "lighting": "even, front-facing",
    "camera_height": "eye level",
    "camera_distance": "constant across all slots",
    "framing": "top of head to collarbone",
    "landmarks": {
      "eyes": "top third line",
      "nose": "center vertical line (front view)",
      "chin": "above bottom third line"
    }
  },
  "slots": [
    { "id": "A", "view": "front", "yaw_deg": 0, "pitch_deg": 0, "required": true, "file": "A_front" },
    { "id": "B", "view": "three_quarter_left", "yaw_deg": -45, "pitch_deg": 0, "required": true, "file": "B_34_left" },
    { "id": "C", "view": "three_quarter_right", "yaw_deg": 45, "pitch_deg": 0, "required": true, "file": "C_34_right" },
    { "id": "D", "view": "profile_left", "yaw_deg": -90, "pitch_deg": 0, "required": true, "file": "D_profile_left" },
    { "id": "E", "view": "profile_right", "yaw_deg": 90, "pitch_deg": 0, "required": true, "file": "E_profile_right" },
    { "id": "F", "view": "back", "yaw_deg": 180, "pitch_deg": 0, "required": false, "required_for": ["3d"], "file": "F_back" },
    { "id": "G1", "view": "look_up", "yaw_deg": 0, "pitch_deg": 20, "required": false, "file": "G1_up" },
    { "id": "G2", "view": "look_down", "yaw_deg": 0, "pitch_deg": -20, "required": false, "file": "G2_down" }
  ],
  "real_photos": {
    "recommended_count": [10, 20],
    "mix_angles": true,
    "consistent_look": ["beard length", "grill or no grill", "glasses or none"]
  },
  "routing": {
    "image_video_generators": "full sheet + real photos",
    "talking_avatar_lipsync": "slot A alone, or 1-2 min talking-to-camera video; never the grid sheet",
    "3d_photogrammetry": "each slot as a separate image tagged with yaw_deg and pitch_deg"
  },
  "characters": {
    "mac": {
      "master_sheet": "reference/character/mac-multi-angle-reference-sheet.png",
      "slots_covered": ["A", "B", "C", "D", "E"],
      "slots_missing": ["F", "G1", "G2"]
    }
  }
}
