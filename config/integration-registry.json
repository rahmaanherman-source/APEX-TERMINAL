  "verification_contract": {
    "registration": "Creates a candidate provider manifest only.",
    "discovery": "Enumerates only resources authorized and actually observable.",
    "connection": "Requires a real adapter path and valid credential reference where required.",
    "testing": "Requires a capability-specific probe with read-back evidence.",
    "verification": "Only the deterministic Comparator and Verify Gate may assign VERIFIED.",
    "unknown_rule": "No probe means UNKNOWN; configuration alone cannot become VERIFIED.",
    "failure_rule": "A failed required probe becomes FAILED or BLOCKED; it never becomes green by fallback.",
    "codec_rule": "Local codecs may be verified through deterministic round-trip tests, but encoding must not be described as cryptographic hashing or encryption."
  }
}
