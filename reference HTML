export async function toggle(id, token) {
  const meta = await validateToken(token, 'apex');
  if (!meta) throw new Error('AUTH_REQUIRED');

  const c = connectors[id];
  if (!c) throw new Error('UNKNOWN_CONNECTOR');

  if (c.status === 'OFF') {
    // zero-config attempt
    if (c.env && !process.env[c.env]) {
      return { id, status: 'MISSING_KEY', message: `Set ${c.env}` };
    }
    c.status = 'ON';
    // real connect logic lives in engine adapters
    return { id, status: 'ON' };
  } else {
    c.status = 'OFF';
    return { id, status: 'OFF' };
  }
}

export function getStatus(id) {
  return connectors[id] || null;
}
