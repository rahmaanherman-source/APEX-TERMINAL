// apex-connectors/google-ai-studio.js
// Production slab — Google AI Studio / Gemini Interactions API
// Env: GEMINI_API_KEY (or GOOGLE_API_KEY)
// Works with @google/genai or plain fetch

import { GoogleGenAI } from '@google/genai'; // npm i @google/genai

const MODEL_DEFAULT = 'gemini-3.7-flash'; // or gemini-3.5-flash / whatever is current

export function createGoogleAIStudio(options = {}) {
  const apiKey = options.apiKey || process.env.GEMINI_API_KEY || process.env.GOOGLE_API_KEY;
  if (!apiKey) {
    return {
      status: 'MISSING_KEY',
      message: 'Set GEMINI_API_KEY',
      ready: false,
    };
  }

  const ai = new GoogleGenAI({ apiKey });

  return {
    id: 'google-ai-studio',
    name: 'Google AI Studio / Gemini',
    status: 'ON',
    ready: true,

    // Primary path — Interactions API (recommended by Google 2026)
    async interact({ model = MODEL_DEFAULT, input, tools = [], agent = null, background = false }) {
      const payload = agent
        ? { agent, input, background }
        : { model, input, tools };
      const interaction = await ai.interactions.create(payload);
      return {
        id: interaction.id || null,
        text: interaction.output_text || interaction.output || '',
        raw: interaction,
      };
    },

    // Classic generateContent (still supported)
    async generate({ model = MODEL_DEFAULT, contents, stream = false }) {
      if (stream) {
        return ai.models.generateContentStream({ model, contents });
      }
      return ai.models.generateContent({ model, contents });
    },

    // OpenAI-compatible path (drop-in for existing OpenAI clients)
    openaiBaseURL: 'https://generativelanguage.googleapis.com/v1beta/openai/',
    openaiKey: apiKey,

    // Health
    async ping() {
      try {
        const r = await this.interact({ input: 'ping' });
        return { ok: true, sample: r.text?.slice(0, 80) };
      } catch (e) {
        return { ok: false, error: e.message };
      }
    },
  };
}

