1. Token Layer (production-ready)
// src/auth/token.js
import crypto from 'node:crypto';
import { createClient } from 'redis'; // optional – falls back to memory

const SECRET = process.env.APEX_SECRET || crypto.randomBytes(32).toString('hex');
const ACCESS_TTL = Number(process.env.APEX_ACCESS_TTL || 900);      // 15 min
const REFRESH_TTL = Number(process.env.APEX_REFRESH_TTL || 604800); // 7 days

let redis = null;
const mem = new Map();          // hash → meta
const userIndex = new Map();    // userId → Set

async function initStore() {
  if (process.env.REDIS_URL) {
    redis = createClient({ url: process.env.REDIS_URL });
    await redis.connect();
  }
}

function h(token) {
  return crypto.createHmac('sha256', SECRET).update(token).digest('hex');
}

async function set(key, meta, ttlSec) {
  if (redis) {
    await redis.set(key, JSON.stringify(meta), { EX: ttlSec });
  } else {
    mem.set(key, { ...meta, exp: Date.now() + ttlSec * 1000 });
  }
}

async function get(key) {
  if (redis) {
    const raw = await redis.get(key);
    return raw ? JSON.parse(raw) : null;
  }
  const m = mem.get(key);
  if (!m || m.exp < Date.now()) {
    mem.delete(key);
    return null;
  }
  return m;
}

async function del(key) {
  if (redis) await redis.del(key);
  else mem.delete(key);
}

export async function issueTokens({
  user = 'owner',
  scope = ['apex', 'unreal', 'blender', 'mcp'],
  aud = 'apex',
} = {}) {
  await initStore();
  const access = crypto.randomUUID();
  const refresh = crypto.randomUUID();

  const accessMeta = { user, scope, aud, type: 'access' };
  const refreshMeta = { user, scope, aud, type: 'refresh' };

  const aH = h(access);
  const rH = h(refresh);

  await set(aH, accessMeta, ACCESS_TTL);
  await set(rH, refreshMeta, REFRESH_TTL);

  if (!userIndex.has(user)) userIndex.set(user, new Set());
  userIndex.get(user).add(aH).add(rH);

  return {
    access_token: access,
    refresh_token: refresh,
    expires_in: ACCESS_TTL,
    token_type: 'Bearer',
  };
}

export async function validateToken(token, neededScope, neededAud = 'apex') {
  if (!token) return null;
  const meta = await get(h(token));
  if (!meta) return null;
  if (neededAud && meta.aud !== neededAud) return null;
  if (neededScope && !meta.scope.includes(neededScope)) return null;
  return meta;
}

export async function revoke(token) {
  const key = h(token);
  const meta = await get(key);
  if (!meta) return false;
  await del(key);
  userIndex.get(meta.user)?.delete(key);
  return true;
}

export async function revokeAllForUser(user) {
  const set = userIndex.get(user);
  if (!set) return 0;
  let n = 0;
  for (const key of set) {
    await del(key);
    n++;
  }
  userIndex.delete(user);
  return n;
}

export async function rotateRefresh(oldRefresh) {
  const meta = await validateToken(oldRefresh);
  if (!meta || meta.type !== 'refresh') return null;
  await revoke(oldRefresh);
  return issueTokens({ user: meta.user, scope: meta.scope, aud: meta.aud });
}

// RFC 7009
export async function revocationEndpoint(req, res) {
  const { token } = req.body || {};
  if (!token) return res.status(400).json({ error: 'invalid_request' });
  await revoke(token);
  res.status(200).json({}); // always 200
}
