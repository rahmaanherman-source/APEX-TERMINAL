Researched across OAuth RFC 7009, Redis opaque-token patterns, high-RPS revocation (local cache + Redis), MCP OAuth 2.1 + audience binding, Unreal Remote Control security, and low-latency real-time systems. Bottlenecks removed: pure in-memory only, no revocation endpoint, no rotation, no audience check, no fail-closed hot path.
Core Design Choices (hand-picked)
	•	Opaque tokens (UUIDv4) stored server-side → instant revoke by DEL.
	•	Short-lived access (15 min default) + rotating refresh.
	•	RFC 7009 revocation endpoint (POST /revoke).
	•	Local in-memory map for sub-ms validation + Redis (or Map) as source of truth.
	•	Token hash stored (never raw token).
	•	Audience / scope binding (critical for MCP + multi-engine).
	•	Nuclear revoke-all by user/owner.
	•	Fail-closed on missing/expired/revoked.
	•	Works local (Map) → scales to Redis without rewrite.
Drop-in Module (`token.js`)
import crypto from 'crypto';

const SECRET = process.env.APEX_SECRET || crypto.randomBytes(32).toString('hex');
const ACCESS_TTL = 900;          // 15 min
const REFRESH_TTL = 7 * 24 * 3600;

// Local hot-path cache (sub-ms). Replace with Redis client for multi-instance.
const store = new Map();         // key = hash(token) → { exp, scope, aud, user, type }
const userTokens = new Map();    // userId → Set of tokenHashes

function hash(token) {
  return crypto.createHmac('sha256', SECRET).update(token).digest('hex');
}

export function issueTokens({ user = 'owner', scope = ['unreal','blender','mcp','pixel'], aud = 'apex' } = {}) {
  const access = crypto.randomUUID();
  const refresh = crypto.randomUUID();
  const now = Date.now();

  const accessMeta = { exp: now + ACCESS_TTL * 1000, scope, aud, user, type: 'access' };
  const refreshMeta = { exp: now + REFRESH_TTL * 1000, scope, aud, user, type: 'refresh' };

  const aHash = hash(access);
  const rHash = hash(refresh);
  store.set(aHash, accessMeta);
  store.set(rHash, refreshMeta);

  if (!userTokens.has(user)) userTokens.set(user, new Set());
  userTokens.get(user).add(aHash).add(rHash);

  return { access_token: access, refresh_token: refresh, expires_in: ACCESS_TTL, token_type: 'Bearer' };
}

export function validateToken(token, neededScope, neededAud = 'apex') {
  if (!token) return false;
  const meta = store.get(hash(token));
  if (!meta || meta.exp < Date.now()) return false;
  if (neededAud && meta.aud !== neededAud) return false;
  if (neededScope && !meta.scope.includes(neededScope)) return false;
  return meta;
}

export function revoke(token) {
  const h = hash(token);
  const meta = store.get(h);
  if (!meta) return false;
  store.delete(h);
  const set = userTokens.get(meta.user);
  if (set) set.delete(h);
  return true;
}

export function revokeAllForUser(user) {
  const set = userTokens.get(user);
  if (!set) return 0;
  let count = 0;
  for (const h of set) {
    store.delete(h);
    count++;
  }
  userTokens.delete(user);
  return count;
}

export function rotateRefresh(oldRefresh) {
  const meta = validateToken(oldRefresh);
  if (!meta || meta.type !== 'refresh') return null;
  revoke(oldRefresh);                       // single-use
  return issueTokens({ user: meta.user, scope: meta.scope, aud: meta.aud });
}
